# Local development only — never commit a real .env, only this .example file.
# Everything here has a working default in config.py when env=dev; only
# override what you're actually testing.

PROVISIONING_ENV=dev

# Optional — blank is fine until you're testing against a real key
PROVISIONING_API_KEY=

# Optional — only needed if you're pointing at something other than the
# dev defaults baked into config.py
# PROVISIONING_PROVISION_URL=https://api.dev.tmtx.bajajauto.com/v1/device/provisioning
# PROVISIONING_REPROVISION_URL=https://api.dev.tmtx.bajajauto.com/v1/device/re-provisioning

PROVISIONING_MODEL_CODE=DEV-MODEL
