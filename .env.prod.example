# Shows which vars load_config("prod") requires. Do not actually run prod off
# a plaintext .env file on the line PCs — inject these through whatever real
# secrets/deployment mechanism you end up using there instead.

PROVISIONING_ENV=prod

PROVISIONING_CAN_INTERFACE=socketcan
PROVISIONING_CAN_CHANNEL=can0
PROVISIONING_CAN_BITRATE=500000

PROVISIONING_UDS_RXID=0x7E8
PROVISIONING_UDS_TXID=0x7E0

PROVISIONING_PROVISION_URL=https://api.tmtx.bajajauto.com/v1/device/provisioning
PROVISIONING_REPROVISION_URL=https://api.tmtx.bajajauto.com/v1/device/re-provisioning
PROVISIONING_API_KEY=REPLACE_ME_FROM_SECRETS_STORE

PROVISIONING_MODEL_CODE=ECX00-V1
